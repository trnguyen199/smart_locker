# ==============================================================================
# SMART LOCKER BACKEND CONFIG (PHẦN NGỌC HIẾU — NHÁNH backend)
# Copy file này thành `.env` cùng thư mục và điền khóa thật từ Supabase.
# TUYỆT ĐỐI KHÔNG COMMIT FILE `.env` LÊN GITHUB!
# ==============================================================================

# 1. Supabase Project & API Keys (chuẩn khóa mới sb_publishable_ & sb_secret_)
SUPABASE_URL=https://rtnvspgxhoouowwrpolz.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_c5oBHtyAsCxM1u7khnse8Q_WerTw-OJ
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY_HERE

# 2. Khóa xác thực thiết bị cho Bản mô phỏng (Phạm Vũ Lân) & Mạch giả lập (Duy Quách)
IOT_DEVICE_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_SECRET

# 3. CORS cho phép bản mô phỏng Web local khác port gọi API
CORS_ALLOWED_ORIGIN=http://127.0.0.1:8000,http://localhost:3000

# Đường dẫn CA bundle cho PHP cURL trên Windows nếu php.ini chưa cấu hình curl.cainfo.
# Ví dụ: C:\path\to\cacert.pem
SUPABASE_CA_BUNDLE=

# Danh sách email được phép bootstrap vai trò ADMIN, phân cách bằng dấu phẩy.
# Chỉ dùng để tạo quản trị viên đầu tiên; sau đó quản lý quyền trong company_members.
ADMIN_EMAILS=

# 4. MQTT Broker Realtime (đồng bộ <100ms giữa Web, Bản mô phỏng và Mạch)
MQTT_WSS_URL=wss://broker.emqx.io:8084/mqtt
MQTT_TOPIC_PREFIX=uth/iot/smartlocker/nhom4

APP_ENV=development
