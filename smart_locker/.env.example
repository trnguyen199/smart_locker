# ==============================================================================
# SMART LOCKER BUSINESS - BACKEND ENVIRONMENT CONFIG (PHẦN NGỌC HIẾU)
# Hướng dẫn: Copy file này thành `.env` cùng thư mục và điền khóa thật từ Supabase.
# TUYỆT ĐỐI KHÔNG COMMIT FILE `.env` LÊN GITHUB VÀ KHÔNG ĐƯA `sb_secret_...` RA TRÌNH DUYỆT!
# ==============================================================================

# 1. Cấu hình Supabase (Chuẩn khóa mới: sb_publishable_... & sb_secret_...)
SUPABASE_URL=https://rtnvspgxhoouowwrpolz.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_c5oBHtyAsCxM1u7khnse8Q_WerTw-OJ
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY_HERE

# 2. Khóa xác thực mạch phần cứng ESP32 / Wokwi khi gọi HTTP API (Header: X-Device-Key)
IOT_DEVICE_KEY=SL_ESP32_UTH_2026_SECRET

# 3. Cấu hình MQTT Broker (Đồng bộ giữa Web và ESP32 Wokwi)
MQTT_WSS_URL=wss://broker.emqx.io:8084/mqtt
MQTT_TOPIC_PREFIX=uth/iot/smartlocker/nhom4

APP_ENV=development
